# Copy this file to .env

# Stripe
# Test keys: https://dashboard.stripe.com/test/apikeys
# Live keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Where the server runs
PORT=3000

# Used to build Stripe success/cancel redirect URLs.
# Use https://your-domain.com in production so Stripe can show product photos.
DOMAIN=http://localhost:3000

# Airtable CMS conf
AIRTABLE_BASE_ID=appXXXXXXXXX
AIRTABLE_PRODUCTS_TABLE=Produtos
AIRTABLE_TOKEN=<token>